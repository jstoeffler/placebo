{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "ignoreDependencies": ["placebo-eval"]
    },
    "packages/core": {},
    "packages/cli": {
      "entry": ["scripts/*.ts", "src/adapters/cli-runner/fixtures/fake-claude.mjs"],
      "ignoreDependencies": ["@placebo-eval/report"]
    },
    "packages/report": {
      "entry": ["src/main.tsx"]
    }
  },
  "ignore": [".claude/worktrees/**", ".placebo/tasks/**"]
}
